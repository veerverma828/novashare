<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (NoActionBar so full-screen WebView apps do not show a native title bar). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#04060c</item>
        <item name="android:colorBackground">#04060c</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#04060c</item>
        <item name="android:colorBackground">#04060c</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#04060c</item>
        <item name="android:colorBackground">#04060c</item>
        <item name="windowSplashScreenBackground">#04060c</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_laser_bolt</item>
        <!-- Must cover the whole animation in whichever splash_laser_bolt.xml this platform
             version loads; a shorter value lets the system exit mid-morph, on a half-folded
             shape. The value is version-qualified alongside the drawable — see
             values/integers.xml. -->
        <item name="windowSplashScreenAnimationDuration">@integer/splash_animation_duration</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>