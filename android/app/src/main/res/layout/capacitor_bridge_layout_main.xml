<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the identically-named layout inside the Capacitor library (app
  resources win over library resources on merge) purely to swap the WebView
  class for RichContentWebView, which advertises image MIME types to the IME
  so Gboard's GIF/sticker pickers work. Everything else must stay identical to
  the upstream layout — the id in particular, since Bridge resolves the WebView
  via R.id.webview.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.veer.novashare.RichContentWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
